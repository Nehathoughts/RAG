# MP2 environment configuration
# ---------------------------------------------------------------
# Copy this file to .env and replace the placeholders with your credentials.
# The script loads .env automatically. Do not commit .env.

OPENAI_API_KEY="your-openai-api-key"
# Only needed for proxy keys (for example Vocareum); leave out for api.openai.com
# OPENAI_BASE_URL="https://openai.vocareum.com/v1"

# Qdrant Cloud free tier (recommended):
#   https://cloud.qdrant.io/ → create cluster → copy URL + API key
QDRANT_URL="https://your-cluster-id.cloud.qdrant.io"
QDRANT_API_KEY="your-qdrant-api-key"

# ─── Local Qdrant alternative ─────────────────────────────────
# If you'd rather run Qdrant locally via Docker:
#     docker run -p 6333:6333 -v $(pwd)/qdrant_storage:/qdrant/storage qdrant/qdrant
# then use:
#     QDRANT_URL="http://localhost:6333"
#     QDRANT_API_KEY=""
